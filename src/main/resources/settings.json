{
  "$schema": "./settings.schema.json",
  "server": {
    "host": "localhost",
    "port": 8765,
    "autoDetectPort": false,
    "apiKeyFile": null
  },
  "llm": {
    "baseUrl": "http://localhost:11434",
    "model": "",
    "think": false,
    "keepAlive": "5m"
  },
  "commandFilter": {
    "blockedExecutables": [
      "mkfs", "mkfs.ext2", "mkfs.ext3", "mkfs.ext4",
      "mkfs.xfs", "mkfs.btrfs", "mkfs.vfat", "mkfs.ntfs",
      "mkswap", "fdisk", "sfdisk", "parted", "gdisk",
      "shutdown", "reboot", "poweroff"
    ],
    "readOnlyAllowedExecutables": [
      "ls", "tree", "pwd", "dir", "cat", "head", "tail", "less", "more",
      "bat", "nl", "od", "hexdump", "xxd", "strings", "grep", "rg", "ag",
      "ack", "find", "wc", "sort", "uniq", "cut", "tr", "awk", "diff",
      "cmp", "xargs", "comm", "join", "paste", "file", "stat", "du", "df",
      "readlink", "realpath", "basename", "dirname", "uname", "whoami",
      "date", "which", "whereis", "type", "id", "groups", "ps", "top",
      "htop", "hostname", "uptime", "arch", "system_profiler", "sw_vers",
      "free", "nproc", "getconf", "lsof", "ping", "nslookup", "dig",
      "host", "python3", "python", "env", "printenv", "echo", "printf",
      "true", "false", "test", "yes"
    ],
    "protectedPaths": {
      "systemPrefixes": [
        "/etc", "/usr", "/var", "/boot", "/bin", "/sbin", "/lib",
        "/lib64", "/opt", "/System", "/Library", "/Applications", "/private"
      ],
      "protectedHomeSubdirectories": [
        ".ssh", ".gnupg", ".aws", ".kube", ".netrc", ".pypirc", ".npmrc", ".docker"
      ],
      "safePathPrefixes": [
        "/tmp"
      ],
      "exactProtectedPaths": [
        "/", "/dev", "/proc", "/sys"
      ]
    }
  }
}