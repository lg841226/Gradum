<idea-plugin>
    <id>com.gradum.idea</id>
    <name>Gradum</name>
    <vendor>Gradum Team</vendor>

    <idea-version since-build="251.2"/>

    <change-notes><![CDATA[N/A]]></change-notes>

    <description><![CDATA[
        Local-first AI code assistant for IntelliJ IDEA.
        Supports Ollama and any OpenAI-compatible inference server.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Gradum"
            icon="/icons/logo/logo.svg"
            anchor="right"
            factoryClass="gradum.idea.GradumToolWindowFactory"/>

        <!--
            Project-scoped chat state. The IntelliJ Platform disposes tool
            window content when the user collapses the sidebar, so any
            in-Compose state is lost on the next expand; holding it in a
            project service keeps the conversation alive across that
            round-trip.
        -->
        <projectService serviceImplementation="gradum.idea.chat.state.GradumChatSession"/>
    </extensions>
</idea-plugin>
