<idea-plugin>
    <id>com.gradum.idea</id>
    <name>Gradum</name>
    <vendor>Gradum Team</vendor>

    <idea-version since-build="251.2"/>

    <change-notes><![CDATA[
        <h3>1.0.4</h3>
        <ul>
            <li>Improved runtime unreachable banner with classified cause and one click installation link.</li>
            <li>MCP server support: connect any MCP server in Settings and its tools become callable skills immediately.</li>
            <li>Chat in editor tabs: open Gradum chat as a full editor tab with a vertical minimap for jump to turn navigation.</li>
        </ul>
        <h3>1.0.3</h3>
        <ul>
            <li>Chat with Ollama and any OpenAI compatible server.</li>
            <li>Agentic tool calling: file, search, and process tools.</li>
            <li>Project aware context with persession history.</li>
            <li>MCP server support.</li>
            <li>Git history analysis tool window.</li>
        </ul>
    ]]></change-notes>

    <description><![CDATA[
        Rooted on your machine: a local runtime for extensible AI agents, packaged for
        IntelliJ IDEA. Coding is the skill set it ships with. Supports Ollama and any
        OpenAI-compatible inference server.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.compose</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            displayName="Gradum"
            instance="gradum.idea.settings.GradumConfigurable"
            id="gradum.settings"
        />

        <toolWindow
            id="Gradum"
            icon="/icons/logo/logo.svg"
            anchor="right"
            factoryClass="gradum.idea.GradumToolWindowFactory"/>

        <toolWindow
            id="Gradum Git"
            icon="/icons/logo/logo.svg"
            anchor="bottom"
            factoryClass="gradum.idea.GradumGitAnalysisToolWindowFactory"/>

        <!--
            Hosts the Gradum chat as an editor tab (Open in Editor title
            action). accept() matches only the GradumChatVirtualFile
            pseudo-file, so no real project file ever routes through the
            chat editor.
        -->
        <fileEditorProvider implementation="gradum.idea.chat.editor.GradumChatEditorProvider"/>

        <!--
            Project-scoped chat scanState. The IntelliJ Platform disposes tool
            window content when the user collapses the sidebar, so any
            in-Compose scanState is lost on the next expand; holding it in a
            project service keeps the conversation alive across that
            round-trip.
        -->
        <projectService serviceImplementation="gradum.idea.chat.state.GradumChatSession"/>

        <!--
            Application-scoped provider settings. Persisted to
            `gradum.xml` in the IDE config directory so URLs, API keys,
            and toggles survive IDE restarts.
        -->
        <applicationService serviceImplementation="gradum.idea.provider.ProviderSettings"/>

        <!--
            Application-scoped appearance settings (animation intensity,
            paragraph density). Persisted to `gradum.xml` alongside
            provider settings.
        -->
        <applicationService serviceImplementation="gradum.idea.settings.AppearanceSettings"/>

        <!--
            Balloon group for settings-side hints: after an MCP server
            lands in settings.json a bottom-right balloon reminds the
            user that the embedded runtime reads `mcpServers` only at
            startup. Looked up by id from `McpServersSettings`.
        -->
        <notificationGroup id="Gradum" displayType="BALLOON"/>

        <!-- Code Vision provider: shows "Explain" action above Java/Kotlin functions -->
        <codeInsight.daemonBoundCodeVisionProvider
            implementation="gradum.idea.editor.GradumCodeVisionProvider"/>

        <!-- Code Vision provider: shows "Update Comments" action above Java/Kotlin functions -->
        <codeInsight.daemonBoundCodeVisionProvider
            implementation="gradum.idea.editor.GradumCommentsCodeVisionProvider"/>

    </extensions>

    <!-- Editor right-click menu: Gradum group with Explain Function action -->
    <actions>
        <group id="Gradum.EditorPopupMenu" class="com.intellij.openapi.actionSystem.DefaultActionGroup" text="Gradum"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="Gradum.ExplainFunction" class="gradum.idea.editor.ExplainFunctionAction"
                    text="Explain Function" description="Attach this function to chat and ask for an explanation"/>
        </group>
    </actions>

</idea-plugin>
