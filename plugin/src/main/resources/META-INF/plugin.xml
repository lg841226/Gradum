<idea-plugin>
    <id>com.gradum.idea</id>
    <name>Gradum</name>
    <vendor>Gradum Team</vendor>

    <idea-version since-build="251.2"/>

    <change-notes><![CDATA[N/A]]></change-notes>

    <description><![CDATA[
        Local-first AI code assistant for IntelliJ IDEA.
        Supports Ollama and any OpenAI-compatible inference server.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.compose</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!--
            The `applicationConfigurable` EP ONLY accepts `instance` or
            `provider` (see Settings Guide → Settings Declaration
            Attributes). Using `implementation=...` looks plausible but
            is silently ignored — the Configurable never registers in
            the Settings tree, so clicking "Gradum" in Tools simply
            shows the parent Tools page instead. Always use `instance`.
        -->
        <applicationConfigurable
            parentId="tools"
            displayName="Gradum"
            instance="gradum.idea.settings.GradumConfigurable"
            id="gradum.settings"
        />

        <toolWindow
            id="Gradum"
            icon="/icons/logo/logo.svg"
            anchor="right"
            factoryClass="gradum.idea.GradumToolWindowFactory"/>

        <toolWindow
            id="Gradum Git"
            icon="/icons/logo/logo.svg"
            anchor="bottom"
            factoryClass="gradum.idea.GradumGitAnalysisToolWindowFactory"/>

        <!--
            Project-scoped chat scanState. The IntelliJ Platform disposes tool
            window content when the user collapses the sidebar, so any
            in-Compose scanState is lost on the next expand; holding it in a
            project service keeps the conversation alive across that
            round-trip.
        -->
        <projectService serviceImplementation="gradum.idea.chat.state.GradumChatSession"/>

        <!--
            Application-scoped provider settings. Persisted to
            `gradum.xml` in the IDE config directory so URLs, API keys,
            and toggles survive IDE restarts.
        -->
        <applicationService serviceImplementation="gradum.idea.provider.ProviderSettings"/>

        <!--
            Application-scoped appearance settings (animation intensity,
            paragraph density). Persisted to `gradum.xml` alongside
            provider settings.
        -->
        <applicationService serviceImplementation="gradum.idea.settings.AppearanceSettings"/>

        <!--
            Notification group used by the image upload pipeline to
            surface size/format/slot-limit errors as IDE balloons. The
            group id matches the string looked up in
            NotificationGroupManager.getInstance().getNotificationGroup
            from `GradumToolWindowFactory`.
        -->
    </extensions>
</idea-plugin>
