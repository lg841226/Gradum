<idea-plugin>
    <id>com.gradum.idea</id>
    <name>Gradum</name>
    <vendor>Gradum Team</vendor>

    <idea-version since-build="251.2"/>

    <change-notes><![CDATA[N/A]]></change-notes>

    <description><![CDATA[
        Local-first AI code assistant for IntelliJ IDEA.
        Supports Ollama and any OpenAI-compatible inference server.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Gradum"
            icon="/icons/logo/logo.svg"
            anchor="right"
            factoryClass="gradum.idea.GradumToolWindowFactory"/>

        <!--
            Project-scoped chat state. The IntelliJ Platform disposes tool
            window content when the user collapses the sidebar, so any
            in-Compose state is lost on the next expand; holding it in a
            project service keeps the conversation alive across that
            round-trip.
        -->
        <projectService serviceImplementation="gradum.idea.chat.state.GradumChatSession"/>

        <!--
            Notification group used by the image upload pipeline to
            surface size/format/slot-limit errors as IDE balloons. The
            group id matches the string looked up in
            NotificationGroupManager.getInstance().getNotificationGroup
            from `GradumToolWindowFactory`.
        -->
        <notificationGroup id="Gradum.Notifications" displayType="BALLOON" isLogByDefault="false"/>

        <!--
            ============================================================
            EXTENSION POINTS
            ============================================================

            These are the SPI entry points that third-party IDE plugins
            can implement to extend the Gradum chat panel without
            modifying this plugin's source.

            Each extension point is registered under the Gradum
            namespace `com.gradum.idea` so the consumer's `plugin.xml`
            uses `defaultExtensionNs="com.gradum.idea"`.

            See `docs/PLUGIN_DEVELOPMENT.md` for full tutorials and
            worked examples.
        -->

        <!--
            Tool-call row renderer SPI. A renderer is responsible for
            parsing a server `tool_call` event's `arguments` + `result`
            fields into a UI view-model, choosing the row's icon and
            localised label, and drawing the actual Compose row.

            Add a renderer by implementing
            `gradum.idea.chat.ui.chat.skill.spi.ToolCallRenderer`
            and registering it like:

                <toolCallRenderer
                    implementation="com.example.MyRenderer"/>

            Aliases are first-registered-wins; render an alias of `"*"`
            to override the wildcard default fallback.
        -->
        <extensionPoint
            name="toolCallRenderer"
            interface="gradum.idea.chat.ui.chat.skill.spi.ToolCallRenderer"/>
    </extensions>

    <!--
        Default tool-call renderers. Each skill alias a server-side
        Gradum `Skill` can emit (Ran / Edited / Read / Saved / Explored
        / Planned / Completed) has a built-in renderer registered here.
        The wildcard DefaultRenderer is the catch-all for any alias
        that has no dedicated renderer.

        The reference XML for each renderer lives at
        `META-INF/extensions/<alias>.xml`. Those files are kept in
        sync with the `<toolCallRenderer>` lines below and serve as
        the per-skill "registration manifest" so a third-party
        developer can see exactly which class implements a given
        alias without opening this file.
    -->
    <extensions defaultExtensionNs="com.gradum.idea">
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.ran.RanRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.edited.EditedRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.read.ReadRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.saved.SavedRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.explored.ExploredRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.planned.PlannedRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.completed.CompletedRenderer"/>
        <toolCallRenderer
            implementation="gradum.idea.chat.ui.chat.skill.default.DefaultRenderer"/>
    </extensions>
</idea-plugin>
