<idea-plugin>
    <id>com.gradum.idea</id>
    <name>Gradum</name>
    <vendor>Gradum Team</vendor>

    <idea-version since-build="251.2"/>

    <change-notes><![CDATA[N/A]]></change-notes>

    <description><![CDATA[
        Local-first AI code assistant for IntelliJ IDEA.
        Supports Ollama and any OpenAI-compatible inference server.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Gradum"
            icon="/icons/logo/logo.svg"
            anchor="right"
            factoryClass="gradum.idea.GradumToolWindowFactory"/>

        <!--
            Project-scoped chat state. The IntelliJ Platform disposes tool
            window content when the user collapses the sidebar, so any
            in-Compose state is lost on the next expand; holding it in a
            project service keeps the conversation alive across that
            round-trip.
        -->
        <projectService serviceImplementation="gradum.idea.chat.state.GradumChatSession"/>

        <!--
            Notification group used by the image upload pipeline to
            surface size/format/slot-limit errors as IDE balloons. The
            group id matches the string looked up in
            NotificationGroupManager.getInstance().getNotificationGroup
            from `GradumToolWindowFactory`.
        -->
        <notificationGroup id="Gradum.Notifications" displayType="BALLOON" isLogByDefault="false"/>
    </extensions>

    <!--
        NOTE on tool-call renderer extensibility:

        The Gradum chat panel's per-skill tool-call rows are
        pluggable through a plain Kotlin interface
        (`gradum.idea.chat.ui.chat.skill.spi.ToolCallRenderer`)
        and an in-process registry
        (`gradum.idea.chat.ui.chat.skill.spi.ToolCallRendererRegistry`).
        They are NOT registered as an IntelliJ Platform
        `ExtensionPoint` — see the registry's KDoc for the
        reasoning.

        Each built-in renderer lives in its own folder under
        `chat/ui/chat/skill/<alias>/` with a matching reference
        manifest at `META-INF/extensions/<alias>.xml`. Adding
        a new alias is a one-line append to the registry's
        `RENDERERS` list. See `docs/PLUGIN_DEVELOPMENT.md`
        section 16 for the full tutorial.
    -->
</idea-plugin>
