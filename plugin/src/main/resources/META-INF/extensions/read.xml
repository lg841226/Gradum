<renderer alias="Read"
          class="gradum.idea.chat.ui.chat.skill.read.ReadRenderer"
          labelKey="gradum.tool.read"
          folder="gradum/idea/chat/ui/chat/skill/read/">
    <description>
        Default renderer for the server-side `read_file` skill.
        Shows the file name and an optional `lines N-M` suffix
        (resolved from the `lineRange` field in the tool result),
        and offers an Open in Editor action that jumps to the
        start line.
    </description>
    <depends-on skill="gradum.skill.ReadFileSkill"/>
    <action-types>
        <action>OpenInEditor</action>
    </action-types>
</renderer>
