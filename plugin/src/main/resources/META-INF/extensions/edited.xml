<renderer alias="Edited"
          class="gradum.idea.chat.ui.chat.skill.edited.EditedRenderer"
          labelKey="gradum.tool.edited"
          folder="gradum/idea/chat/ui/chat/skill/edited/">
    <description>
        Default renderer for the server-side `edit_file` skill.
        Shows the file name, a `+linesAdded` / `-linesRemoved`
        delta, and offers a View Diff action when the tool result
        carried an `originalContent` + `modifiedContent` payload.
    </description>
    <depends-on skill="gradum.skill.EditFileSkill"/>
    <action-types>
        <action>ViewDiff</action>
        <action>OpenInEditor</action>
    </action-types>
</renderer>
