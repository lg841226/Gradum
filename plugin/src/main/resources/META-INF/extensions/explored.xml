<renderer alias="Explored"
          class="gradum.idea.chat.ui.chat.skill.explored.ExploredRenderer"
          labelKey="gradum.tool.explored"
          folder="gradum/idea/chat/ui/chat/skill/explored/">
    <description>
        Default renderer for the server-side `explore_project`
        skill. Shows the project directory's basename and a
        "depth N" suffix indicating how many levels the scan
        went.
    </description>
    <depends-on skill="gradum.skill.ExploreProjectSkill"/>
    <action-types/>
</renderer>
