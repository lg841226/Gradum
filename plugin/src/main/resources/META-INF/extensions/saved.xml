<renderer alias="Saved"
          class="gradum.idea.chat.ui.chat.skill.saved.SavedRenderer"
          labelKey="gradum.tool.saved"
          folder="gradum/idea/chat/ui/chat/skill/saved/">
    <description>
        Default renderer for the server-side `save_file` skill.
        Shows the file name plus a human-readable size suffix
        (e.g. "Build.kt 4.2 KB") when the tool result included
        a `sizeBytes` value, and offers an Open in Editor action.
    </description>
    <depends-on skill="gradum.skill.SaveFileSkill"/>
    <action-types>
        <action>OpenInEditor</action>
    </action-types>
</renderer>
