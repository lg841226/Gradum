  ~
  ~ ran.xml — registration manifest for the Ran tool-call renderer.
  ~
  ~ This file is a documentation reference kept in sync with the
  ~ `<toolCallRenderer>` line in `META-INF/plugin.xml`. The actual
  ~ IntelliJ Platform extension registration is consolidated in
  ~ `plugin.xml` (the platform only reads `META-INF/plugin.xml`),
  ~ but splitting the manifest per skill makes it trivial to find
  ~ "which class implements the Ran alias?" without scrolling
  ~ through 200+ lines of `plugin.xml`.
  ~
  ~ Keep this file in sync with the `RanRenderer` class:
  ~   - alias(): the server-side Skill.alias this renderer handles
  ~   - labelKey(): the GradumBundle resource key for the row's label
  -->

<renderer alias="Ran"
          class="gradum.idea.chat.ui.chat.skill.ran.RanRenderer"
          labelKey="gradum.tool.ran"
          folder="gradum/idea/chat/ui/chat/skill/ran/">
    <description>
        Default renderer for the server-side `run_cmd` skill.
        Shows the command and the model's one-line `reason`,
        exposes a Copy action for the command, and an Open in
        Editor action that writes the command to a temp .sh file
        and opens it (so the user can inspect / tweak before
        re-running).
    </description>
    <depends-on skill="gradum.skill.RunCommandSkill"/>
    <action-types>
        <action>CopyToClipboard</action>
        <action>OpenInEditor</action>
    </action-types>
</renderer>
